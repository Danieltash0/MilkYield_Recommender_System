PORT=5000
DB_HOST=localhost
# 3307 = the docker-compose MySQL (npm run db:up). Port 3306 is left free for a
# locally installed MySQL; use 3306 here if you run against that instead.
DB_PORT=3307
DB_USER=root
DB_PASSWORD=rootpass
DB_NAME=dairydan_db
JWT_SECRET=change-this-secret

# Milk yield recommender
# ma = 7-session moving average (default). lr / nn = the ONNX model in
# server/ml/models; auto = whichever model_meta.json says scored best.
# The bundled models are trained on SYNTHETIC data: keep ma until you retrain.
PREDICTOR=ma
MILKINGS_PER_DAY=2
# Optional: load the ONNX models from another folder
# MODELS_DIR=
# Optional: reword alert notes with an OpenAI-compatible API (both key and model
# must be set; numbers the engine did not supply are rejected)
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=
