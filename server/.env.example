PORT=5000
DB_HOST=localhost
# 3307 = the docker-compose MySQL (npm run db:up). Port 3306 is left free for a
# locally installed MySQL; use 3306 here if you run against that instead.
DB_PORT=3307
DB_USER=root
DB_PASSWORD=rootpass
DB_NAME=dairydan_db
# Hosted MySQL (Aiven, TiDB Cloud, ...): encrypt the connection. DB_SSL_CA is the
# provider's CA certificate (PEM) when it is not a public CA; newlines may be written as \n.
# DB_SSL=true
# DB_SSL_CA=
# Use a long random value, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# With NODE_ENV=production the server refuses to start without one (32+ characters).
JWT_SECRET=change-this-secret
# How long a sign-in lasts (default 12h)
# JWT_EXPIRES_IN=12h
# Browser origins allowed to call the API directly (comma-separated).
# Not needed in development: the React dev server proxies /api.
# CLIENT_ORIGIN=http://localhost:3000
# Proxies in front of the server, so rate limits see the real client IP.
# Default: loopback (the CRA dev proxy). On Render: 1
# TRUST_PROXY=1
# NODE_ENV=production

# Milk yield recommender
# ma = 7-session moving average (default). lr / nn = the ONNX model in
# server/ml/models; auto = whichever model_meta.json says scored best.
# The bundled models are trained on SYNTHETIC data: keep ma until you retrain.
PREDICTOR=ma
MILKINGS_PER_DAY=2
# Optional: load the ONNX models from another folder
# MODELS_DIR=
# Optional: reword alert notes with an OpenAI-compatible API (both key and model
# must be set; numbers the engine did not supply are rejected)
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=
